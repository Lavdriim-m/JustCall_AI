{
  "name": "@justcall/voice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "tsx --env-file-if-exists=../../.env src/doctor.ts",
    "chat": "tsx --env-file-if-exists=../../.env scripts/chat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-polly": "^3.1149.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1149.0",
    "@fastify/formbody": "^9.0.1",
    "@fastify/websocket": "^11.3.4",
    "@justcall/core": "workspace:*",
    "@justcall/db": "workspace:*",
    "@justcall/services": "workspace:*",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.46.0",
    "nodemailer": "^7.0.13",
    "openai": "^7.32.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.0.0",
    "postgres": "^3.4.9",
    "swissqrbill": "^4.4.2",
    "twilio": "^6.1.2",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^4.0.0"
  }
}
