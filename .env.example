# =============================================================================
#  JustCall – environment variables
#  Copy to `.env` (local development) or set them in your hosting provider.
#  Detailed, step-by-step instructions for every service: docs/SETUP.md
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# Any PostgreSQL 15+ works. For Supabase use the "Session pooler" connection
# string (Project → Connect). URL-encode special characters in the password
# (e.g. "@" → "%40", "#" → "%23").
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR-URL-ENCODED-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Public URLs (required)
# ---------------------------------------------------------------------------
# Web app (admin console + restaurant portal)
APP_URL=http://localhost:3000
# Voice server – must be reachable by Twilio over HTTPS in production
VOICE_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Secrets (required) – generate each with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
# Session signing for the web app
BETTER_AUTH_SECRET=
# Shared between web app and voice server (simulator tokens, internal calls)
INTERNAL_API_SECRET=
# Protects /api/cron/* endpoints (Vercel Cron sends it as Bearer token)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Language model
# LLM_PROVIDER: openai | anthropic | demo (demo = rule-based, no key needed)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Fast models work best on the phone. Good choices: gpt-5.4-mini (default),
# gpt-5.4-nano (cheapest), gpt-4.1-mini, gpt-5.4 (smartest, slower).
OPENAI_MODEL=gpt-5.4-mini
# Only used for reasoning models (gpt-5.x / o-series): none | minimal | low
OPENAI_REASONING_EFFORT=none
# Optional: Azure OpenAI / proxy compatible endpoint
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Speech-to-text (STT) and text-to-speech (TTS)
# STT_PROVIDER: aws | azure | openai
# TTS_PROVIDER: polly | azure | elevenlabs | openai
# Recommended for Swiss German: STT aws (de-CH) or azure (de-CH),
#                               TTS polly (Sabrina, de-CH) or azure (de-CH-LeniNeural)
# Only-OpenAI setup for quick testing: STT_PROVIDER=openai, TTS_PROVIDER=openai
# ---------------------------------------------------------------------------
STT_PROVIDER=aws
TTS_PROVIDER=polly

# AWS (Transcribe + Polly)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TRANSCRIBE_LANGUAGE=de-CH
POLLY_VOICE=Sabrina
POLLY_ENGINE=generative

# Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=switzerlandnorth
AZURE_STT_LANGUAGE=de-CH
AZURE_TTS_VOICE=de-CH-LeniNeural

# ElevenLabs (premium voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI speech (uses OPENAI_API_KEY)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ---------------------------------------------------------------------------
# Twilio (phone numbers, call routing, SMS)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default SMS sender: an alphanumeric sender ID (max 11 chars, e.g. JustCall),
# a Twilio number (+41…) or a Messaging Service SID (MG…). Restaurants can
# override the sender name in their settings.
TWILIO_SMS_FROM=JustCall
# Media edge close to Switzerland: frankfurt | dublin
TWILIO_EDGE=frankfurt
# Leave true in production. Set false only for local testing without Twilio.
TWILIO_VALIDATE_SIGNATURES=true
# Optional: regulatory bundle/address for buying Swiss numbers via the app
TWILIO_CH_BUNDLE_SID=
TWILIO_CH_ADDRESS_SID=

# ---------------------------------------------------------------------------
# Email (invoices, invitations, password resets) – any SMTP provider
# e.g. Resend: host smtp.resend.com, port 465, user "resend", password = API key
# Without SMTP, emails are printed to the server log.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=JustCall <billing@example.ch>

# ---------------------------------------------------------------------------
# Background jobs & behaviour
# ---------------------------------------------------------------------------
# Monthly invoice generation runs inside the voice server (1st of month, 06:00 Zurich)
JOBS_ENABLED=true
# true = invoices are emailed automatically; false = admin reviews drafts first
INVOICE_AUTO_SEND=false
# Delete call transcripts older than N days (0 = keep forever)
TRANSCRIPT_RETENTION_DAYS=180

# Voice tuning
CALL_MAX_DURATION_SECONDS=900
END_OF_TURN_MS=700
SILENCE_PROMPT_SECONDS=10
LOG_LEVEL=info
PORT=8080
