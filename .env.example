# =============================================================================
#  JustCall – environment variables
#  Copy to `.env` (local development) or set them in your hosting provider.
#  Step-by-step instructions and the full variable reference: docs/SETUP.md
#  Optional variables are commented out with their default. Leave a variable
#  out (or commented) rather than empty: some defaults only apply when it is
#  missing.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# Any PostgreSQL 15+ works. For Supabase copy the "Session pooler" URI exactly
# as shown under Connect: the host prefix (aws-0-, aws-1-, …) differs between
# projects, so don't build it from the region. Percent-encode special
# characters in the password (e.g. "@" → "%40", "#" → "%23").
# Serverless hosts (Vercel): Transaction pooler (port 6543), DATABASE_POOL_MAX=1-3.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR-URL-ENCODED-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Connections per process; keep it × instances below the session pooler's Pool Size
DATABASE_POOL_MAX=10

# docker-compose.yml only: password of the bundled Postgres (letters and digits
# only; applied when the pgdata volume is first created) and an optional
# external database URL (e.g. Supabase) that replaces the bundled one.
# POSTGRES_PASSWORD=justcall-local-password
# COMPOSE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Public URLs (required in production)
# ---------------------------------------------------------------------------
# Web app (admin console + restaurant portal)
APP_URL=http://localhost:3000
# Voice server – must be reachable by Twilio over HTTPS in production
VOICE_PUBLIC_URL=http://localhost:8080
# Optional: URL the web app uses to reach the voice server internally
# (default: VOICE_PUBLIC_URL; docker-compose sets http://voice:8080)
# VOICE_INTERNAL_URL=http://voice:8080

# ---------------------------------------------------------------------------
# Secrets – required in production (each: openssl rand -base64 32).
# In development the web app and voice server fall back to the same insecure
# built-in value, so local runs work without them.
# ---------------------------------------------------------------------------
# Session signing for the web app (the voice server does not read it)
BETTER_AUTH_SECRET=
# Shared between web app and voice server (simulator tokens, internal calls);
# must be identical on both
INTERNAL_API_SECRET=
# Only for an external scheduler calling /api/cron/monthly-invoices when the
# voice server's job is off (JOBS_ENABLED=false). There is no Vercel cron.
# Leave empty otherwise.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Language model
# LLM_PROVIDER: openai | anthropic | demo (demo = rule-based, no key needed)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
# Also needed for the AI menu import, even with LLM_PROVIDER=anthropic
OPENAI_API_KEY=
# Fast models work best on the phone: gpt-5.4-mini (default), gpt-6-luna
# (cheapest, effort none only), gpt-4.1-mini (non-reasoning fallback),
# gpt-5.5 (smarter, slower). gpt-5.4-nano is deprecated (shutdown 2027-04-01).
# Never gpt-6-astra or gpt-6.1-sol: no function calling in Chat Completions.
OPENAI_MODEL=gpt-5.4-mini
# none (recommended for phone latency) | low | medium. "minimal" only exists
# for the older gpt-5 / gpt-5-mini. Ignored by gpt-4.1-mini.
OPENAI_REASONING_EFFORT=none
# Optional: Azure OpenAI / proxy compatible endpoint
OPENAI_BASE_URL=
# Optional: model for the AI menu import (default: OPENAI_MODEL)
# OPENAI_MENU_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Speech-to-text (STT) and text-to-speech (TTS)
# STT_PROVIDER: aws | azure | openai | mock (local testing, no keys)
# TTS_PROVIDER: polly | azure | elevenlabs | openai | mock (local testing, no keys)
# Recommended for Swiss German: STT aws (de-CH) or azure (de-CH),
#                               TTS polly (Sabrina, de-CH) or azure (de-CH-LeniNeural)
# Only-OpenAI setup for quick testing: STT_PROVIDER=openai, TTS_PROVIDER=openai
# ---------------------------------------------------------------------------
STT_PROVIDER=aws
TTS_PROVIDER=polly

# AWS (Transcribe + Polly). Quotas are per region: raise them in AWS_REGION.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TRANSCRIBE_LANGUAGE=de-CH
# Optional: Transcribe custom vocabulary and partial-result stabilization
# TRANSCRIBE_VOCABULARY_NAME=
# TRANSCRIBE_PARTIAL_STABILIZATION=false
POLLY_VOICE=Sabrina
POLLY_ENGINE=generative

# Azure AI Speech (Foundry resource for Speech, pricing tier Standard S0)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=switzerlandnorth
AZURE_STT_LANGUAGE=de-CH
AZURE_TTS_VOICE=de-CH-LeniNeural

# ElevenLabs (Standard German; use a Swiss-accented or cloned voice, not a
# Default voice – those expire on 2026-12-31)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# OpenAI speech (uses OPENAI_API_KEY) – for testing only: OpenAI has deprecated
# gpt-4o-transcribe (shutdown 2027-02-26) and the dated gpt-4o-mini-tts
# snapshots (shutdown 2027-01-06)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ---------------------------------------------------------------------------
# Twilio (phone numbers, call routing, SMS)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default SMS sender: an alphanumeric sender ID (max 11 chars, e.g. JustCall;
# enable it under Messaging → Settings → General) or a Messaging Service SID
# (MG…). Swiss local (+41 44 …) numbers cannot send SMS. Restaurants can
# override the sender name in their settings.
TWILIO_SMS_FROM=JustCall
# Twilio REST API edge (number management, transfers, SMS). No effect on call
# audio: calls and media streams run in Twilio's default US1 region.
TWILIO_EDGE=frankfurt
# Leave true in production. Set false only for local testing without Twilio.
TWILIO_VALIDATE_SIGNATURES=true
# Optional: Swiss regulatory bundle/address (type Local, end-user Business)
# for buying Swiss numbers in the app
TWILIO_CH_BUNDLE_SID=
TWILIO_CH_ADDRESS_SID=

# ---------------------------------------------------------------------------
# Email (invoices, invitations, password resets, order emails) – any SMTP
# provider, e.g. Resend: host smtp.resend.com, port 465, user "resend",
# password = API key. Without SMTP, emails are printed to the server log.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=JustCall <billing@example.ch>

# ---------------------------------------------------------------------------
# Background jobs & behaviour (voice server)
# ---------------------------------------------------------------------------
# Monthly invoices (1st of the month, 06:00 Zurich) and daily maintenance run
# inside the voice server. This is the only scheduler; there is no Vercel cron.
JOBS_ENABLED=true
# true = the voice job emails the invoices it creates; false = admin reviews
# drafts and sends them from Invoices
INVOICE_AUTO_SEND=false
# Delete call transcripts older than N days (0 = keep forever)
TRANSCRIPT_RETENTION_DAYS=180

# Voice tuning
CALL_MAX_DURATION_SECONDS=900
END_OF_TURN_MS=700
SILENCE_PROMPT_SECONDS=10
# BARGE_IN_MIN_WORDS=2
# TTS_CACHE_MB=64
LOG_LEVEL=info
PORT=8080
# HOST=0.0.0.0
# Seconds running calls get to finish on shutdown. Production hosts set 290
# (render.yaml, fly.toml, docker-compose.yml; shutdown timeout 300 s).
# DRAIN_TIMEOUT_SECONDS=25
